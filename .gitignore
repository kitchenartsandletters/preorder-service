.nox/
tests/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# macOs
.DS_Store

# IDEs / Editors
.idea/
.vscode/
*.swp
*.swo

# Environment Variables (IMPORTANT: never commit secrets)
.env
.env.local
