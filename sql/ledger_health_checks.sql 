-- ============================================
-- PREORDER LEDGER HEALTH CHECKS
-- These queries detect structural corruption
-- in preorder.commitment_ledger.
-- ============================================


-- 1. NEGATIVE COMMITMENT DETECTION
-- Any product with negative commitments indicates
-- lifecycle events exceeded creates.
select
  product_id,
  sum(delta_qty) as ledger_balance
from preorder.commitment_ledger
group by product_id
having sum(delta_qty) < 0;



-- 2. DUPLICATE EVENT DETECTION
-- Detect duplicate webhook ingestion.
select
  topic,
  event_id,
  line_item_id,
  product_id,
  delta_qty,
  count(*) as duplicate_count
from preorder.commitment_ledger
group by
  topic,
  event_id,
  line_item_id,
  product_id,
  delta_qty
having count(*) > 1;



-- 3. REFUND MAPPING VALIDATION
-- Refund rows should never have order_id == refund_id.
select *
from preorder.commitment_ledger
where topic = 'refunds/create'
and order_id = refund_id;



-- 4. GHOST COMMITMENT DETECTION
-- Positive ledger creates that do not correspond
-- to a Shopify order line.
select
  l.product_id,
  l.order_id,
  l.line_item_id
from preorder.commitment_ledger l
left join shopify_orders_stage s
  on l.order_id = s.order_id
 and l.line_item_id = s.line_item_id
where l.delta_qty > 0
and s.order_id is null;



-- 5. MISSING CREATE EVENTS
-- Lifecycle events without a corresponding create.
select
  product_id,
  order_id,
  line_item_id,
  sum(delta_qty) as lifecycle_balance
from preorder.commitment_ledger
group by
  product_id,
  order_id,
  line_item_id
having sum(delta_qty) < 0;


-- 6. EVENT ORDERING VIOLATIONS
-- Detect lifecycle events that occur before the corresponding create.
-- This indicates webhook ingestion ordering problems.
with create_events as (
  select
    product_id,
    order_id,
    line_item_id,
    min(occurred_at) as create_time
  from preorder.commitment_ledger
  where delta_qty > 0
  group by
    product_id,
    order_id,
    line_item_id
),
lifecycle_events as (
  select
    product_id,
    order_id,
    line_item_id,
    topic,
    occurred_at
  from preorder.commitment_ledger
  where delta_qty < 0
)
select
  l.product_id,
  l.order_id,
  l.line_item_id,
  l.topic,
  l.occurred_at,
  c.create_time
from lifecycle_events l
left join create_events c
  on l.product_id = c.product_id
 and l.order_id = c.order_id
 and l.line_item_id = c.line_item_id
where c.create_time is null
   or l.occurred_at < c.create_time;